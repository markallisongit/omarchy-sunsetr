#!/bin/bash

# omarchy:summary=Install or remove mark.sunsetr's Omarchy integration
# omarchy:args=[--yes] [--uninstall]
# omarchy:examples=bin/setup --yes

set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SHELL_JSON="$HOME/.config/omarchy/shell.json"
MENU_JSONC="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
BIN_LINK="$HOME/.local/bin/sunsetr-nightlight"
DEFAULT_INDICATORS='["Dictation","ScreenRecording","Reminder","NightLight","Dnd","StayAwake"]'

ASSUME_YES=0
UNINSTALL=0
for arg in "$@"; do
  case "$arg" in
    --yes) ASSUME_YES=1 ;;
    --uninstall) UNINSTALL=1 ;;
    *) echo "sunsetr setup: unknown argument: $arg" >&2; exit 1 ;;
  esac
done

fail() { echo "sunsetr setup: $*" >&2; exit 1; }

# Read from extensions/omarchy-menu.jsonc rather than keeping a second
# hardcoded copy of the fragment here - a second copy is exactly how this
# drifted out of sync with that file's icon glyph before. `jq -ce` doubles
# as validation: it exits nonzero if the key is missing or its value is
# null, so a malformed extensions file fails loudly instead of installing
# a broken fragment.
menu_fragment_from_extensions() {
  local ext="$PLUGIN_DIR/extensions/omarchy-menu.jsonc" value
  value=$(sed -e 's#^[[:space:]]*//.*$##' "$ext" | jq -ce '.["trigger.toggle.nightlight"]') || return 1
  printf '  "trigger.toggle.nightlight": %s' "$value"
}
MENU_FRAGMENT=$(menu_fragment_from_extensions) || fail "could not read menu fragment from $PLUGIN_DIR/extensions/omarchy-menu.jsonc"

interactive() { [[ -t 0 && -t 1 ]]; }
confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then gum confirm "$prompt"
  else fail "refusing to continue without confirmation; pass --yes"
  fi
}
backup() {
  local f="$1"
  [[ -f $f ]] || return 0
  # A fixed name (not a timestamp) rather than glob-discovered later: every
  # call site below only ever backs up a given file once per install (each
  # is guarded by an already-applied check, or SHELL_JSON_BACKED_UP), so
  # there's never more than one legitimate backup to find. Picking "whichever
  # matching file has the newest mtime" at restore time would instead trust
  # any file another local process happened to drop in this same
  # user-writable directory. -n leaves an existing backup alone rather than
  # clobbering it, in case backup() is ever called twice for the same file
  # across separate runs without an uninstall in between.
  cp -n "$f" "$f.bak.sunsetr"
}

# shell.json can get edited by more than one install step (indicator removal,
# native-nightlight disable). backup() only ever keeps a single backup per
# file, so a second per-step backup would silently orphan the first edit's
# true-original copy - uninstall would only undo the last edit, not both.
# Backing it up once per run, on first touch, is what keeps "restore the
# whole file" correct regardless of how many steps end up editing it.
SHELL_JSON_BACKED_UP=0
backup_shell_json() {
  (( SHELL_JSON_BACKED_UP )) && return 0
  backup "$SHELL_JSON"
  SHELL_JSON_BACKED_UP=1
}

manifest_default() {
  jq -r --arg k "$1" '.barWidget.defaults[$k] // empty' "$PLUGIN_DIR/manifest.json"
}

create_presets() {
  local day_preset night_preset duration
  day_preset=$(manifest_default dayPreset); day_preset=${day_preset:-day}
  night_preset=$(manifest_default nightPreset); night_preset=${night_preset:-night}
  duration=$(manifest_default forceTransitionSeconds); duration=${duration:-2}
  "$PLUGIN_DIR/bin/sunsetr-ensure-preset" "$day_preset" day "$duration" || fail "could not create '$day_preset' preset"
  "$PLUGIN_DIR/bin/sunsetr-ensure-preset" "$night_preset" night "$duration" || fail "could not create '$night_preset' preset"
}

install_cli() {
  mkdir -p "$HOME/.local/bin"
  if [[ -L $BIN_LINK ]] && [[ "$(readlink -f "$BIN_LINK")" == "$PLUGIN_DIR/bin/sunsetr-nightlight" ]]; then
    return 0
  fi
  if [[ -e $BIN_LINK || -L $BIN_LINK ]]; then
    confirm "Replace existing $BIN_LINK ?" || return 0
    backup "$BIN_LINK"
    rm -f "$BIN_LINK"
  fi
  ln -s "$PLUGIN_DIR/bin/sunsetr-nightlight" "$BIN_LINK"
}

remove_nightlight_indicator() {
  [[ -f $SHELL_JSON ]] || return 0
  local already_excluded
  already_excluded=$(jq --argjson defaults "$DEFAULT_INDICATORS" '
    [.bar.layout // {} | to_entries[] | .value[]? | select(.id == "omarchy.indicators") | ((.items // $defaults) | index("NightLight"))] | any
  ' "$SHELL_JSON")
  [[ $already_excluded == "false" ]] && return 0

  confirm "Remove the stock NightLight indicator from shell.json?" || return 0
  backup_shell_json
  local tmp
  # mktemp rather than a fixed "$SHELL_JSON.tmp": a predictable path in a
  # user-writable directory is a symlink target waiting to happen - plant a
  # symlink there ahead of time and this redirect would follow it and
  # overwrite whatever it points at instead. Same directory as SHELL_JSON so
  # the final mv is an atomic rename, not a cross-filesystem copy.
  tmp=$(mktemp "$SHELL_JSON.XXXXXX")
  jq --argjson defaults "$DEFAULT_INDICATORS" '
    (.bar.layout // {}) |= with_entries(
      .value |= map(
        if .id == "omarchy.indicators" and ((.items // $defaults) | index("NightLight") != null)
        then .items = ((.items // $defaults) - ["NightLight"])
        else . end
      )
    )
  ' "$SHELL_JSON" > "$tmp"
  mv "$tmp" "$SHELL_JSON"
}

# Distinct from remove_nightlight_indicator: that just hides the bar icon.
# The icon and the omarchy.nightlight *service* plugin are independent -
# Indicators.qml loads NightLight.qml purely from shell.json's items list,
# never checking whether the service behind it is registry-enabled, and
# NightLight.qml itself just falls back to "inactive" (not hidden) when the
# service is gone. So skipping this step even after the icon is removed would
# still leave the native service switchable elsewhere (Omarchy's settings UI,
# its "nightlight" IPC target) and fighting sunsetr for control of the
# display's gamma/temperature.
disable_native_nightlight() {
  local enabled
  enabled=$(omarchy plugin list --json 2>/dev/null | jq -r '
    [.[] | select(.id == "omarchy.nightlight" and .enabled == true)] | any
  ')
  [[ $enabled == "true" ]] || return 0

  confirm "Disable Omarchy's built-in Night Light service (mark.sunsetr replaces it)?" || return 0
  backup_shell_json
  omarchy plugin disable omarchy.nightlight || fail "could not disable omarchy.nightlight"
}

install_menu_override() {
  mkdir -p "$(dirname "$MENU_JSONC")"
  if [[ ! -f $MENU_JSONC ]]; then
    printf '{\n%s\n}\n' "$MENU_FRAGMENT" > "$MENU_JSONC"
    return
  fi
  grep -q '"trigger.toggle.nightlight"' "$MENU_JSONC" && return 0
  confirm "Add the sunsetr nightlight menu override to $MENU_JSONC ?" || return 0
  backup "$MENU_JSONC"
  local tmp
  # Same directory as MENU_JSONC (not the default TMPDIR) so the final mv is
  # an atomic same-filesystem rename.
  tmp=$(mktemp "$MENU_JSONC.XXXXXX")
  # Insert frag as the new FIRST property, right after the opening brace,
  # always followed by a comma. That's unconditionally valid JSON/JSONC no
  # matter what follows it (an existing property, a comment, a blank line,
  # or nothing) - no lookback needed. The previous approach inserted before
  # the closing brace and needed to decide whether the line above it needed
  # a trailing comma added; that lookback got it wrong when that line was a
  # comment or blank (comma landed on the comment, not the real property),
  # producing invalid JSONC that Omarchy's menu parser then discards the
  # user's *entire* menu file for.
  awk -v frag="$MENU_FRAGMENT" '
    !done && /^[ \t]*\{[ \t]*$/ {
      print
      print frag ","
      done = 1
      next
    }
    { print }
  ' "$MENU_JSONC" > "$tmp"
  mv "$tmp" "$MENU_JSONC"
}

enable_plugin() {
  # `omarchy plugin list`'s plain output lists every discovered plugin
  # regardless of state, so a plain `grep -q mark.sunsetr` matches a
  # disabled entry just as readily as an enabled one and short-circuits
  # before `enable` ever runs. --json exposes the actual boolean.
  local already_enabled
  already_enabled=$(omarchy plugin list --json 2>/dev/null | jq -r '
    [.[] | select(.id == "mark.sunsetr" and .enabled == true)] | any
  ')
  [[ $already_enabled == "true" ]] && return 0
  omarchy plugin enable mark.sunsetr center || fail "could not enable mark.sunsetr - is it added via 'omarchy plugin add'?"
}

require_sunsetr() {
  command -v sunsetr >/dev/null 2>&1 && return 0
  fail "sunsetr is not installed. Install it first, then re-run this setup: https://github.com/psi4j/sunsetr"
}

# sunsetr's own docs (https://psi4j.github.io/sunsetr/quick-start.html)
# present two independent, equally-official autostart methods - a compositor
# `exec-once`/`spawn-at-startup` line, or `systemctl --user enable --now
# sunsetr.service` - and installing the package sets up neither one for you.
# Service.qml only ever launches sunsetr in response to a toggle/force click
# (see its ensureRunningAndApply), so a fresh install with no autostart
# configured at all leaves the bar widget stuck on "loading..." forever.
# Skip entirely if sunsetr wasn't installed via a package that ships the
# systemd unit (e.g. built from source) - not this script's problem to solve.
compositor_autostarts_sunsetr() {
  # GNU grep exits 2 (not the "no match" 1) when any argument path is
  # missing, even if another one matched - so passing both dirs unconditionally
  # and relying on `&& return 0` would silently never trigger on the (common)
  # Hyprland-only setup with no ~/.config/niri at all. Only grep dirs that exist.
  local dirs=() d
  for d in "$HOME/.config/hypr" "$HOME/.config/niri"; do
    [[ -d $d ]] && dirs+=("$d")
  done
  (( ${#dirs[@]} )) || return 1
  grep -rqE '^[[:space:]]*(exec-once|spawn-at-startup)\b.*\bsunsetr\b' "${dirs[@]}" 2>/dev/null
}

# sunsetr.service is Type=simple, so `systemctl --user start` returns as soon
# as the process forks - well before sunsetr has connected to the compositor
# backend and opened its control socket. create_presets runs right after this
# and needs that socket (`sunsetr get`), so a freshly-started sunsetr needs to
# be waited on. Same socket path and wait pattern as Service.qml's own
# readiness probe.
wait_for_sunsetr_socket() {
  local socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sunsetr-events.sock"
  timeout 30 sh -c 'until [ -S "$0" ]; do sleep 0.1; done' "$socket" ||
    fail "sunsetr did not become ready within 30s of starting"
}

# Enabling and starting are handled separately (never a bare `enable --now`):
# a sunsetr already running - started by hand, or by a previous toggle
# through this plugin's own uwsm-app fallback - is invisible to systemd's
# unit state (`is-active` reports "inactive" for it regardless), so `--now`
# there would spawn a second, duplicate sunsetr fighting the first one for
# the display and the event socket. Enabling is always safe to repeat (just
# (re)writes the .wants symlink); starting only happens when no sunsetr
# process exists at all.
enable_sunsetr_service() {
  systemctl --user list-unit-files sunsetr.service >/dev/null 2>&1 || return 0
  # A compositor-configured autostart is the user's own choice of the other
  # official method - enabling systemd on top would double-start sunsetr on
  # every subsequent boot, not just right now, so leave it alone entirely.
  compositor_autostarts_sunsetr && return 0
  local already_running=0 enabled
  pgrep -x sunsetr >/dev/null && already_running=1
  enabled=$(systemctl --user is-enabled sunsetr.service 2>/dev/null || true)
  (( already_running )) && [[ $enabled == "enabled" ]] && return 0

  confirm "Enable sunsetr's systemd service (so it runs automatically)?" || return 0
  systemctl --user enable sunsetr.service || fail "could not enable sunsetr.service"
  if (( ! already_running )); then
    systemctl --user start sunsetr.service || fail "could not start sunsetr.service"
    wait_for_sunsetr_socket
  fi
}

do_install() {
  require_sunsetr
  enable_sunsetr_service
  create_presets
  install_cli
  # disable_native_nightlight persists shell.json from the live shell's
  # in-memory config (via `omarchy plugin disable`'s IPC call), while
  # remove_nightlight_indicator edits the file on disk directly with jq.
  # Running the direct-disk edit last means it always starts from whatever
  # disable_native_nightlight just wrote, rather than risking the in-memory
  # write clobbering it before the shell has reloaded from disk.
  disable_native_nightlight
  remove_nightlight_indicator
  install_menu_override
  enable_plugin
  echo "sunsetr setup: install complete."
}

# --- Uninstall -------------------------------------------------------------
# Restoring from the backups install already creates on every
# edit is far more reliable than re-deriving the inverse of each jq/awk
# transformation, and it's exactly what the backups exist for.

restore_backup() {
  local f="$1"
  local backup="$f.bak.sunsetr"
  [[ -e $backup ]] || return 1
  # backup() only ever creates a plain file at this exact path - refuse to
  # act on anything else found there instead of trusting it by name/mtime
  # alone. A symlink or a file this user doesn't own could only get to this
  # path via something other than backup() itself (another local process
  # sharing this user-writable directory, or a crash leaving something
  # unexpected behind).
  if [[ -L $backup ]]; then
    echo "sunsetr setup: refusing to restore $backup: it is a symlink" >&2
    return 1
  fi
  if [[ ! -f $backup ]]; then
    echo "sunsetr setup: refusing to restore $backup: not a regular file" >&2
    return 1
  fi
  if [[ ! -O $backup ]]; then
    echo "sunsetr setup: refusing to restore $backup: not owned by the current user" >&2
    return 1
  fi
  mv "$backup" "$f"
  return 0
}

uninstall_cli() {
  [[ -L $BIN_LINK ]] || return 0
  [[ "$(readlink -f "$BIN_LINK")" == "$PLUGIN_DIR/bin/sunsetr-nightlight" ]] || return 0
  rm -f "$BIN_LINK"
}

restore_shell_json() {
  # One restore undoes both edits that can land in this file (indicator
  # removal, native-nightlight disable) - see backup_shell_json's comment for
  # why they share a single backup instead of each restoring independently.
  restore_backup "$SHELL_JSON" || true
}

_trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

restore_menu_jsonc() {
  if restore_backup "$MENU_JSONC"; then
    return 0
  fi
  # No backup means bin/setup created the file from scratch (it didn't exist
  # before install). Only remove it if it is *exactly* the untouched
  # generated template (3 lines: "{", the fragment, "}") - if the user added
  # anything to it after install, leave it in place rather than risk
  # deleting their customizations.
  if [[ -f $MENU_JSONC ]]; then
    local lines
    lines=$(wc -l < "$MENU_JSONC")
    # Only attempt to read the 3 expected lines when there actually are 3 -
    # under set -e, an unconditional read past EOF on a shorter file (e.g. a
    # user-minified single-line version of the fragment) would abort the
    # whole script here, killing do_uninstall before it could get to
    # remove_generated_presets.
    if [[ $lines -eq 3 ]]; then
      local first second third
      { IFS= read -r first; IFS= read -r second; IFS= read -r third; } < "$MENU_JSONC"
      if [[ "$(_trim "$first")" == "{" && "$(_trim "$third")" == "}" \
            && "$(_trim "$second")" == "$(_trim "$MENU_FRAGMENT")" ]]; then
        rm -f "$MENU_JSONC"
      fi
    fi
  fi
}

remove_generated_presets() {
  local day_preset night_preset
  day_preset=$(manifest_default dayPreset); day_preset=${day_preset:-day}
  night_preset=$(manifest_default nightPreset); night_preset=${night_preset:-night}
  for name in "$day_preset" "$night_preset"; do
    local f="$HOME/.config/sunsetr/presets/$name/sunsetr.toml"
    [[ -f $f ]] || continue
    # Only remove presets this plugin generated and the user never touched -
    # our generated files always start with this exact marker comment.
    if head -n1 "$f" | grep -q "^# Generated by omarchy-sunsetr"; then
      rm -f "$f"
      rmdir "$HOME/.config/sunsetr/presets/$name" 2>/dev/null || true
    fi
  done
}

do_uninstall() {
  confirm "Uninstall mark.sunsetr's Omarchy integration (CLI symlink, menu override, indicator + native nightlight restore, generated presets)?" || exit 0
  sunsetr preset default >/dev/null 2>&1 || true
  uninstall_cli
  restore_shell_json
  restore_menu_jsonc
  remove_generated_presets
  echo "sunsetr setup: uninstall complete. Run 'omarchy plugin remove mark.sunsetr' to remove the plugin itself."
}

if (( UNINSTALL )); then
  do_uninstall
else
  do_install
fi
