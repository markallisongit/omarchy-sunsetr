#!/bin/bash

# omarchy:summary=Create a sunsetr day/night preset if missing, seeded from live config
# omarchy:args=<preset-name> <day|night> <fade-seconds>
# omarchy:examples=sunsetr-ensure-preset day day 2

set -euo pipefail

fail() {
  echo "sunsetr-ensure-preset: $*" >&2
  exit 1
}

name="${1:-}"
kind="${2:-}"
duration="${3:-2}"

[[ -n $name ]] || fail "preset name is required"
# name becomes a path component below (and sunsetr itself will later resolve
# it the same way) - restricting it to a safe charset up front rules out
# traversal ("../..") and absolute-path tricks entirely, rather than trying
# to sanitize a path after the fact.
[[ $name =~ ^[A-Za-z0-9_-]+$ ]] || fail "preset name must contain only letters, digits, '-' and '_', got '$name'"
[[ $kind == "day" || $kind == "night" ]] || fail "kind must be 'day' or 'night', got '$kind'"
[[ $duration =~ ^[0-9]+$ ]] || fail "fade duration must be a non-negative integer, got '$duration'"

preset_dir="$HOME/.config/sunsetr/presets/$name"
preset_file="$preset_dir/sunsetr.toml"

# This script only ever creates plain directories/files of its own at these
# paths - a symlink already sitting at either one was planted by something
# else, and mkdir/redirection would silently follow it. Refuse rather than
# write through it.
[[ -L $preset_dir ]] && fail "refusing to use '$preset_dir': it is a symlink"
[[ -L $preset_file ]] && fail "refusing to use '$preset_file': it is a symlink"

# Never overwrite an existing preset - forceTransitionSeconds only takes
# effect the first time this preset is created.
[[ -f $preset_file ]] && exit 0

temp_field="${kind}_temp"
gamma_field="${kind}_gamma"

values=$(sunsetr get --json "$temp_field" "$gamma_field") || fail "could not read live sunsetr config"
temp=$(jq -r --arg f "$temp_field" '.[$f]' <<<"$values")
gamma=$(jq -r --arg f "$gamma_field" '.[$f]' <<<"$values")

# Both fields land straight in the TOML below without quoting, so they must
# be validated as bare numbers first - not just "non-null" - or a stray quote
# or newline in either value would inject arbitrary TOML.
[[ $temp =~ ^-?[0-9]+$ ]] || fail "expected a numeric $temp_field from sunsetr, got '$temp'"
[[ $gamma =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || fail "expected a numeric $gamma_field from sunsetr, got '$gamma'"

mkdir -p "$preset_dir"
# Written to a private temp file in the same directory and renamed into
# place, so a crash or interrupt mid-write can never leave a torn preset
# file behind, and the write never has the chance to follow a symlink
# planted at preset_file's path after the checks above ran.
tmp_file=$(mktemp "$preset_dir/.sunsetr.toml.XXXXXX")
cat > "$tmp_file" <<EOF
# Generated by omarchy-sunsetr on first use of the "$name" preset, seeded
# from your live sunsetr ${kind}_temp/${kind}_gamma at the time. Existing
# preset files are never overwritten - edit this one directly (temperature,
# gamma, or the fade duration below) to change its behavior.
transition_mode = "static"
static_temp = $temp
static_gamma = $gamma
smoothing = true
startup_duration = $duration
EOF
mv "$tmp_file" "$preset_file"
